{
  "name": "openfox-opencode-go",
  "version": "2.1.1",
  "description": "OpenCode Go provider plugin for OpenFox",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "openfox": {
    "apiVersion": 2,
    "displayName": "OpenCode Go",
    "description": "Access curated open coding models with generous limits via your OpenCode Go subscription with live quota tracking.",
    "icon": "https://opencode.ai/_build/assets/preview-opencode-logo-dark-ZBwNGoYp.png",
    "entry": "./dist/index.js",
    "capabilities": [
      "tools",
      "hooks",
      "rpc",
      "presets"
    ],
    "timeoutMs": 15000
  },
  "peerDependencies": {
    "openfox": ">=2.0.56 <3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.15",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
